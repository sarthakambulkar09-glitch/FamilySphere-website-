rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Is user authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Is Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'sarthakambulkar09@gmail.com' ||
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Publicly viewable family collections
    match /families/{familyId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /family_branches/{branchId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /family_members/{memberId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isAuthenticated() && resource.data.owner_user_id == request.auth.uid
      );
    }

    match /family_relationships/{relationshipId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /family_photos/{photoId} {
      allow read: if resource.data.visibility == 'public' || isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && resource.data.uploaded_by == request.auth.token.email
      );
    }

    match /family_memories/{memoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /pending_approvals/{approvalId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && resource.data.requested_by_user_id == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
